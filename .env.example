# Zaika environment variables.
# Copy this file to .env (git-ignored) and fill in real values. Only the `mysql` profile reads them;
# dev and test run on H2 and need nothing. Real environment variables override values in .env.
# Format: KEY=value, no quotes, no spaces around '='.

# JDBC URL of the MySQL 8 database (required for the mysql profile)
DB_URL=jdbc:mysql://localhost:3306/zaika
# MySQL user that owns the zaika database (required)
DB_USER=zaika
# Password of that MySQL user (required, never commit it)
DB_PASSWORD=change-me

# SMTP server for outgoing email such as password resets (default: localhost)
SMTP_HOST=smtp.example.com
# SMTP port, usually 587 for STARTTLS (default: 587)
SMTP_PORT=587
# SMTP login user name (leave empty if the server needs no login)
SMTP_USERNAME=
# SMTP login password or app password (never commit it)
SMTP_PASSWORD=
# Whether the SMTP server requires a login: true or false (default: true)
SMTP_AUTH=true
# Whether to upgrade the connection with STARTTLS: true or false (default: true)
SMTP_STARTTLS=true
# Sender shown on outgoing email, e.g. Zaika <no-reply@yourdomain.in> (default: Zaika <no-reply@zaika.test>)
MAIL_FROM=Zaika <no-reply@zaika.test>

# Public address of the site without a trailing slash; links in emails point here (default: http://localhost:8080)
APP_BASE_URL=http://localhost:8080

# Email of the first admin account. On startup, if no admin exists yet, one is created with this email and
# ADMIN_PASSWORD; once an admin exists both are ignored (default: empty, no admin is created)
ADMIN_EMAIL=admin@yourdomain.in
# Password of that first admin: 8+ characters with a letter and a digit (never commit it)
ADMIN_PASSWORD=

# Load the demo restaurants, menus and accounts on startup: true or false (default: false)
SEED_DEMO=false

# Secret that signs "Keep me signed in" cookies: a long random string, e.g. 32+ characters (never commit it).
# If empty, a random key is made at startup and remember-me cookies stop working after every restart.
REMEMBER_ME_KEY=
